# Copy to .env before running the app:  cp .env.example .env
#
# These are local development values that match docker-compose.yml. They are
# not secrets and there is no production service behind them. Real deployments
# would inject these from the environment, and .env stays gitignored either way.

# --- PostgreSQL (metadata only - never file bytes) ---
DATABASE_URL="postgres://research:research@localhost:5432/research_uploads"

# Separate database used by the test suite, created by docker/postgres-init.
TEST_DATABASE_URL="postgres://research:research@localhost:5432/research_uploads_test"

# --- MinIO (private S3-compatible object storage - file bytes only) ---
# These credentials stay on the server. The browser never receives them; it
# only ever receives short-lived presigned URLs generated with them.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minio-dev-user"
MINIO_SECRET_KEY="minio-dev-password"
MINIO_BUCKET="research-uploads"

# --- Development tracing (optional) ---
# Set to true to print every authorization decision and signed URL to the
# server terminal. Off by default. It changes only what the terminal prints -
# HTTP responses are byte-identical either way, deliberately, because a debug
# flag that made a refusal explain itself would be the exact leak this app is
# built to prevent.
DEBUG_AUTHZ="false"
